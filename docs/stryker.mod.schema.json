{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stryker.local/schemas/stryker.mod.schema.json",
  "title": "STRYKER mod manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["name", "components"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "maxLength": 40 },
    "author": { "type": "string", "maxLength": 120 },
    "category": { "enum": ["gameplay", "turf", "menu", "audio", "kit", "face", "scoreboard", "other"] },
    "compatibility": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 100 } },
    "sourceUrl": { "type": "string", "format": "uri", "maxLength": 1000 },
    "dependencies": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "version": { "type": "string", "maxLength": 40 }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "root"],
            "properties": { "type": { "const": "livecpk" }, "root": { "type": "string", "minLength": 1 } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "root", "entrypoints"],
            "properties": {
              "type": { "const": "lua" },
              "root": { "type": "string", "minLength": 1 },
              "entrypoints": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "\\.lua$" } }
            }
          }
        ]
      }
    }
  }
}
