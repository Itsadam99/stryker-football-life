{
  "name": "stryker-football-life",
  "version": "3.9.2",
  "description": "Gestionnaire local de mods pour SP Football Life et PES 2021",
  "author": "Adam",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node server/index.js",
    "build": "tsc && vite build",
    "build:site": "tsc && node scripts/build-site.mjs",
    "check": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/api-security.test.js test/archive-installation.test.js test/catalog.test.js test/dlss-manager.test.js test/game-detection.test.js test/mod-engine.test.js test/protocol-links.test.js test/repository.test.js test/sider-manager.test.js test/update-manager.test.js",
    "preview": "vite preview",
    "predesktop": "npm run build",
    "desktop": "electron .",
    "package:win": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis --publish never",
    "installer:art": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer-art.ps1",
    "release": "node scripts/publish-release.mjs",
    "release:check": "node scripts/publish-release.mjs --dry"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "lucide-react": "^1.16.0",
    "node-unrar-js": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "^0.2.0",
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^8.0.0"
  },
  "build": {
    "appId": "com.stryker.footballlife",
    "productName": "STRYKER",
    "protocols": [
      {
        "name": "STRYKER Mod Installer",
        "schemes": [
          "stryker"
        ]
      }
    ],
    "artifactName": "STRYKER-Setup-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "bundled-mods/**/*",
      "electron/**/*",
      "server/**/*.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server/browseGame.ps1",
        "to": "scripts/browseGame.ps1"
      },
      {
        "from": "server/browseArchive.ps1",
        "to": "scripts/browseArchive.ps1"
      },
      {
        "from": "server/browseDlssNr.ps1",
        "to": "scripts/browseDlssNr.ps1"
      },
      {
        "from": "server/launchExecutable.ps1",
        "to": "scripts/launchExecutable.ps1"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/stryker.ico"
    },
    "nsis": {
      "oneClick": false,
      "installerIcon": "public/stryker.ico",
      "uninstallerIcon": "public/stryker.ico",
      "installerHeaderIcon": "public/stryker.ico",
      "installerHeader": "build/installer-header.bmp",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "STRYKER"
    }
  }
}
